	(text "USB SHIELD - not tied to GND:\nR75 1M || C32 4.7nF(100V) -> GND"
		(exclude_from_sim no)
		(at 21.336 29.972 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "742977df-8f21-4156-869a-ccd8327e483e")
	)
	(text "Power Budget & Protection Calculation:\n- Single Board Base Draw (RP2040 + Flash + 6 I2C Sensors + Status LEDs): ~45 mA\n- Active RGB LED Array (8x RGB LEDs, active on ONLY 1 board at a time): ~182 mA max (24 ch x 7.6 mA, R22 = 10k, see LED sheet)\n- Total Expected Draw for 6 Daisy-Chained Boards: (6 * 45 mA) + 182 mA = 452 mA\n- F1 / F2 Selection: 750 mA Hold Current (I_hold = 0.75A > 452mA, I_trip = 1.5A <= LM66100 1.5A max rating)\n- D28 / D29 Selection: 5.0V Standoff TVS (V_rwm = 5.0V, V_br = 6.4V) for ESD & surge clamping."
		(exclude_from_sim no)
		(at 20.32 103.886 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "c346881a-4da3-4bb1-b615-1cf57b5cca11")
	)
