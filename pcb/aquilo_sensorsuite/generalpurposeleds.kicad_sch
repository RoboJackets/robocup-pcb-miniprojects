			)
		)
		(uuid "bcfc3b00-d322-4c2c-869a-54f87554a9dc")
	)
	(text "Output drive strength from the pads (Each GPIO is connected to the\noff-chip world via a \"pad\") can only be set to 2, 4, 8, 12 mA. \nSince the typical amps for these LEDs are 20 mA, we can take\n12 mA as the ceiling amperage.\n"
		(exclude_from_sim no)
		(at 104.14 135.89 0)
