	(label "USB_MCU_D-" (at 43.18 106.68 0) (effects (font (size 0.7 0.7)) (justify left bottom)) (uuid "3b9fc0eb-b952-57d6-8f85-b7f54fb89b0e"))

	(label "USB_MCU_D+" (at 43.18 109.22 0) (effects (font (size 0.7 0.7)) (justify left bottom)) (uuid "3adeb04c-c899-5d8f-b8b2-f7ed620050a9"))

	(text "RP2040 U1\n3V3 I/O, internal core regulator.\n12 MHz crystal; external QSPI Flash.\nUSB series R5/R6 = 27.4 ohm.\nUSB routing target: 90 ohm differential.\nMCU-side pair: USB_MCU_D+ / D-." (at 17 16 0) (effects (font (size 0.95 0.95)) (justify left top)) (uuid "27c57947-2ba1-5358-8337-4b676d529a3e"))

	(text "Crystal load: C_L = C14*C15/(C14+C15) + C_stray\n15pF/15pF -> 7.5pF + assumed 2.5pF = 10pF.\nABM8-272-T3, 12MHz, C_L=10pF; stray load requires validation." (at 170 158 0) (effects (font (size 0.9 0.9)) (justify left top)) (uuid "647de4d6-c53b-56da-9a66-683ec53d4b8b"))

	(text "BOOT: hold SW2 BOOTSEL, pulse SW1 RUN reset, then release for USB programming.\nFirmware: Pico SDK, two cores; independent I2C pin pairs; no external sensor IRQs.\nUSB pair geometry and impedance must be implemented and checked during PCB design." (at 18 184 0) (effects (font (size 0.9 0.9)) (justify left top)) (uuid "f405d293-7c49-57a8-980b-a4a5e00cab92"))
)
