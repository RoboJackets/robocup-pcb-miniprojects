(version 1)
(rule "U7 package pad clearance"
  (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.memberOfFootprint('U7') && B.memberOfFootprint('U7')")
  (constraint clearance (min 0.15mm)))

(rule "U11 package pad clearance"
  (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.memberOfFootprint('U11') && B.memberOfFootprint('U11')")
  (constraint clearance (min 0.175mm)))