                        (width 10000)
                      )
                      (pt -160000 200000
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (arc CW
                        (r 10000)
                        (begin
                          (pt -240000 210000
                            (width 20000)
                          )
                        )
                        (center 0 0)
                        (end
                          (pt -240000 210000
                            (width 20000)
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
           ); End of layout
         ); End of heelprint
